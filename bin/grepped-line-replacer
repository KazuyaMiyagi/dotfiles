#! /usr/bin/env bash

set -e -u -o pipefail

# grep -n の結果を書き換えたリストを読み、各行をファイルの該当する行に書き戻す。

if [[ "$(uname)" == 'Darwin' ]]; then
    SED_COMMAND='gsed'
else
    SED_COMMAND='sed'
fi
readonly SED_COMMAND

function usage() {
    local COMMAND="grepped-line-replacer"
    readonly COMMAND
    cat <<- HEREDOC
		Usage: ${COMMAND} [FILE]

		Read lines in the grep -n format (PATH:LINE:CONTENT) from FILE or stdin
		and replace line LINE of PATH with CONTENT.

		Examples:
		    grep -n "word" > list
		    vim list
		    ${COMMAND} < list
	HEREDOC
}

function grepped_line_replacer() {
    if [[ "${INPUT_FILE}" == "/dev/stdin" && ! -s "${INPUT_FILE}" ]]; then
        usage >&2
        exit 1
    fi

    local IFS=$'\n'
    local line file_name line_number new_content escaped_content
    while read -r line; do
        file_name="$(echo "${line}" | cut -d ':' -f 1)"
        line_number="$(echo "${line}" | cut -d ':' -f 2)"
        new_content="$(echo "${line}" | cut -d ':' -f 3-)"
        escaped_content="$(echo "${new_content}" | sed 's/[\\&/]/\\&/g')"
        "${SED_COMMAND}" -i "${line_number}s/.*/${escaped_content}/" "${file_name}"
    done < "${INPUT_FILE}"
}

INPUT_FILE="${1:-/dev/stdin}"
readonly INPUT_FILE

grepped_line_replacer
