#! /usr/bin/env bash

set -e -u -o pipefail

# PR に自分以外のコメント・レビュー・レビュースレッドへの書き込みや push されたコミットが増えるか、
# head の CI が終わるか、ほかの人が auto merge を有効にするか、PR がマージ・クローズされるまで待ち、
# 増えたものを出して終わる。
# --follow では終わらずに出し続け、PR がマージ・クローズされたら終わる。

INTERVAL=60
readonly INTERVAL
MAX_TRIES=720
readonly MAX_TRIES
# $o などは GraphQL の変数で、シェルに展開させないためシングルクォートで囲む
# shellcheck disable=SC2016
QUERY='query($o: String!, $r: String!, $n: Int!) {
  repository(owner: $o, name: $r) {
    pullRequest(number: $n) {
      state url
      autoMergeRequest { enabledBy { login } mergeMethod }
      comments(last: 100) { nodes { author { login } url } }
      reviews(last: 100) { nodes { author { login } state url } }
      reviewThreads(last: 100) { nodes { comments(last: 50) { nodes { author { login } url } } } }
      commits(last: 100) { nodes { commit { url author { user { login } } } } }
      head: commits(last: 1) { nodes { commit { url statusCheckRollup { state } } } }
    }
  }
}'
readonly QUERY

function usage() {
    local COMMAND="gh-watch-pr-activity"
    readonly COMMAND
    cat <<- HEREDOC
		Usage: ${COMMAND} [OPTIONS] OWNER/REPO PR

		Wait until someone else comments on, reviews or pushes commits to
		the pull request, the checks on its head commit finish, someone else
		enables auto-merge, or it is merged or closed, then print the new
		activity and exit.

		Options:
		  -f, --follow      Keep printing new activity until the pull request is merged or closed
		  -s, --state FILE  Save what has been printed to FILE and resume from it
		  -h, --help        Show this help

		Arguments:
		  OWNER/REPO  Repository of the pull request
		  PR          Pull request number
	HEREDOC
}

function __snapshot() {
    local repo="${1}"
    local pr="${2}"
    local me="${3}"
    gh api graphql -F o="${repo%/*}" -F r="${repo#*/}" -F n="${pr}" -f query="${QUERY}" --jq "
        .data.repository.pullRequest as \$p
        | ([\$p.comments.nodes[] | select(.author.login != \"${me}\") | \"comment \(.author.login) \(.url)\"]
          + [\$p.reviews.nodes[] | select(.author.login != \"${me}\") | \"review \(.author.login) \(.state) \(.url)\"]
          + [\$p.reviewThreads.nodes[].comments.nodes[] | select(.author.login != \"${me}\") | \"thread \(.author.login) \(.url)\"]
          + [\$p.commits.nodes[].commit | select(.author.user.login != \"${me}\") | \"commit \(.author.user.login // \"unknown\") \(.url)\"]
          + [\$p.head.nodes[].commit | select(.statusCheckRollup.state // \"\" | IN(\"SUCCESS\", \"FAILURE\", \"ERROR\")) | \"checks \(.statusCheckRollup.state) \(.url)\"]
          + [\$p | select(.autoMergeRequest != null and .autoMergeRequest.enabledBy.login != \"${me}\") | \"automerge \(.autoMergeRequest.enabledBy.login) \(.autoMergeRequest.mergeMethod) \(.url)\"]
          + [\$p | select(.state != \"OPEN\") | \"state \(.state) \(.url)\"])[]" \
        | sort
}

function gh_watch_pr_activity() {
    local args=()
    local follow=false
    local state=""

    while [[ ${#} -gt 0 ]]; do
        case "${1}" in
            -h | --help)
                usage
                exit 0
                ;;
            -f | --follow)
                follow=true
                shift
                ;;
            -s | --state)
                if [[ ${#} -lt 2 ]]; then
                    usage >&2
                    exit 1
                fi
                state="${2}"
                shift 2
                ;;
            -*)
                echo "Error: unknown option: ${1}" >&2
                exit 1
                ;;
            *)
                args+=("${1}")
                shift
                ;;
        esac
    done

    if [[ ${#args[@]} -ne 2 || ! "${args[0]}" =~ ^[^/]+/[^/]+$ || ! "${args[1]}" =~ ^[0-9]+$ ]]; then
        usage >&2
        exit 1
    fi

    local repo="${args[0]}"
    local pr="${args[1]}"
    local me
    me="$(gh api user --jq .login)"

    local base
    if [[ -n "${state}" && -s "${state}" ]]; then
        base="$(< "${state}")"
    else
        base="$(__snapshot "${repo}" "${pr}" "${me}")"
        if grep -q '^state ' <<< "${base}"; then
            echo "Error: ${repo}#${pr} is not open" >&2
            exit 1
        fi
        if [[ -n "${state}" ]]; then
            echo "${base}" > "${state}"
        fi
    fi

    local i now added
    for ((i = 1; i <= MAX_TRIES; i++)); do
        sleep "${INTERVAL}"
        if ! now="$(__snapshot "${repo}" "${pr}" "${me}")"; then
            continue
        fi
        added="$(comm -13 <(echo "${base}") <(echo "${now}"))"
        if [[ -n "${added}" ]]; then
            echo "$(date +%H:%M) ${repo}#${pr} new activity:"
            echo "${added}"
            base="${now}"
            if [[ -n "${state}" ]]; then
                echo "${base}" > "${state}"
            fi
            if [[ "${follow}" == false ]] || grep -q '^state ' <<< "${added}"; then
                return
            fi
        fi
    done

    if [[ "${follow}" == true ]]; then
        return
    fi
    echo "Error: no new activity on ${repo}#${pr} within $((INTERVAL * MAX_TRIES / 3600))h" >&2
    exit 1
}

gh_watch_pr_activity "${@}"
