#! /usr/bin/env bash

set -e -u -o pipefail

# GitHub の Organization にある、アーカイブされていないリポジトリをすべて ghq でクローンする。

function usage() {
    local COMMAND="org-repos-clone"
    readonly COMMAND
    cat <<- HEREDOC
		Usage: ${COMMAND} <ORG> [LIMIT]

		Clone every non-archived repository of ORG with ghq.

		Arguments:
		    ORG    GitHub organization or user
		    LIMIT  Maximum number of repositories to list (default: 1000)
	HEREDOC
}

function org_repos_clone() {
    if [[ -z "${ORG}" ]]; then
        usage >&2
        exit 1
    fi

    local repo
    while IFS= read -r -u 3 repo; do
        ghq get "${ORG}/${repo}"
    done 3< <(gh repo list "${ORG}" --limit "${LIMIT}" --no-archived --json 'name' | jq -r '.[].name')
}

ORG="${1:-""}"
readonly ORG

LIMIT="${2:-1000}"
readonly LIMIT

org_repos_clone
