#! /usr/bin/env bash

set -e -u -o pipefail

function org_repos_clone() {
    local repo
    for repo in $(gh repo list "${ORG}" --limit "${LIMIT}" --no-archived --json 'name' | jq -r '.[].name'); do
        ghq get "${ORG}/${repo}"
    done
}

ORG="${1:?Usage: org-repos-clone <org>}"
readonly ORG

LIMIT="${2:-1000}"
readonly LIMIT

org_repos_clone
