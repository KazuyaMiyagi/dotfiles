#! /usr/bin/env bash

set -e -u -o pipefail

# 毎日の作業として、全リポジトリの更新・bootstrap・リポジトリの状態の確認を続けて行う。

DOTFILES_DIR="$(ghq root)/github.com/KazuyaMiyagi/dotfiles"
readonly DOTFILES_DIR

function daily_routine() {
    echo -e "\n==> Updating all repos...\n"
    all-repo-update

    echo -e "\n==> Running bootstrap...\n"
    "${DOTFILES_DIR}/scripts/bootstrap"

    echo -e "\n==> Checking repos status...\n"
    repos-status

    echo -e "\n==> Checking installed asdf tool versions...\n"
    asdf list

    echo -e "\n==> Checking Terraform and TFLint plugin caches...\n"
    tree "${TF_PLUGIN_CACHE_DIR}" "${HOME}/.tflint.d"

    echo -e "\n==> Checking files in Desktop and Downloads...\n"
    ls -alh "${HOME}/Desktop" "${HOME}/Downloads"

    echo -e "\n==> Daily routine completed!\n"
}

daily_routine
