#! /usr/bin/env bash

set -e -u -o pipefail

# Claude Code の PreToolUse hook。
# 次の Bash コマンドのときだけ承認ダイアログを出し、それ以外は何も返さずに通す。
#   - gh api でのコメント・レビューの投稿（読むだけの gh api は通す）
#   - レビュー依頼済みの PR のブランチでの rebase / amend / force push

function __ask() {
    local reason="${1}"
    jq -n --arg reason "${reason}" '{
        hookSpecificOutput: {
            hookEventName: "PreToolUse",
            permissionDecision: "ask",
            permissionDecisionReason: $reason
        }
    }'
    exit 0
}

# gh api は読み取りにも使うので、本文を送るか POST/PATCH するものだけを投稿とみなす
function __is_posting() {
    local command="${1}"
    grep -Eq '(^|[;&|(][[:space:]]*)gh[[:space:]]+api[[:space:]]' <<< "${command}" \
        && grep -Eq '(comments|reviews|replies)' <<< "${command}" \
        && grep -Eq '((-f|-F|--field|--raw-field)[[:space:]=]+body=|(-X|--method)[[:space:]=]*(POST|PATCH))' <<< "${command}"
}

function __is_rewriting_history() {
    local command="${1}"
    local git_command='(^|[;&|(][[:space:]]*)git[[:space:]]+'
    grep -Eq "${git_command}(rebase|commit[[:space:]].*--amend|push[[:space:]].*(--force|[[:space:]]-f([[:space:]]|$)|[[:space:]]\+))" <<< "${command}"
}

function agent_review_guard() {
    local input command cwd
    input="$(cat)"
    command="$(jq -r '.tool_input.command // empty' <<< "${input}")"
    cwd="$(jq -r '.cwd // empty' <<< "${input}")"

    if __is_posting "${command}"; then
        __ask "Posting a comment or review with gh api"
    fi

    if ! __is_rewriting_history "${command}"; then
        return
    fi

    if [[ -n "${cwd}" ]]; then
        cd "${cwd}"
    fi

    # PR が無いブランチは依頼前なので通す。それ以外の取得失敗は判断できないので確認に回す
    local pr
    if ! pr="$(gh pr view --json isDraft,reviewRequests,reviews 2>&1)"; then
        if grep -qi 'no pull requests found' <<< "${pr}"; then
            return
        fi
        __ask "Could not get the pull request state. Confirm before rewriting history"
    fi

    # draft 中に付く Copilot や bot のレビューは、レビュー依頼とはみなさない
    local requested
    requested="$(jq -r '
        (.isDraft | not) and (
            (.reviewRequests | length > 0)
            or ([.reviews[] | select(.author.login | test("copilot|\\[bot\\]$") | not)] | length > 0)
        )
    ' <<< "${pr}")"

    if [[ "${requested}" == "true" ]]; then
        __ask "Rewriting commit history on a branch whose pull request is under review"
    fi
}

agent_review_guard
