#! /usr/bin/env bash

set -e -u -o pipefail

case "$(uname)" in
    Darwin) REALPATH_CMD="grealpath" ;;
    *) REALPATH_CMD="realpath" ;;
esac
readonly REALPATH_CMD

# 配色
BG_ORANGE="196,123,92" # Claude のサーモン
readonly BG_ORANGE
BG_GRAY1="80,78,76"    # 灰（明るめ）
readonly BG_GRAY1
BG_GRAY2="68,66,64"    # 灰
readonly BG_GRAY2
BG_GRAY3="56,54,52"    # 灰（暗め）
readonly BG_GRAY3
BG_GRAY4="46,44,42"    # 灰（より暗め）
readonly BG_GRAY4
BG_GRAY5="38,36,34"    # 灰（いちばん暗い）
readonly BG_GRAY5
FG_DARK="20,20,20"     # 黒に近い色
readonly FG_DARK
FG_LIGHT="220,218,214" # 白に近い色
readonly FG_LIGHT
FG_GREEN="152,151,26"  # gruvbox の緑
readonly FG_GREEN
FG_YELLOW="215,153,33" # gruvbox の黄
readonly FG_YELLOW
FG_RED="204,36,29"     # gruvbox の赤
readonly FG_RED

# 書式の指示を順に出力する。
#   Background=<color> -> 背景色を設定する
#   Foreground=<color> -> 文字色を設定する
#   Text=<text>        -> 文字列を出力する
#   ResetAttributes    -> 属性をすべて戻す
function __format() {
    local directive rgb
    for directive in "${@}"; do
        case "${directive}" in
            Background=*)
                rgb="${directive#Background=}"
                printf '\e[48;2;%sm' "${rgb//,/;}"
                ;;
            Foreground=*)
                rgb="${directive#Foreground=}"
                printf '\e[38;2;%sm' "${rgb//,/;}"
                ;;
            Text=*) printf '%s' "${directive#Text=}" ;;
            ResetAttributes) printf '\e[0m' ;;
        esac
    done
}

# 割合に応じた円グラフのアイコン: 󰝦 󰪞 󰪟 󰪠 󰪡 󰪢 󰪣 󰪤 󰪥
# 空と満杯のアイコンが受け持つ範囲を対称（0-6% と 94-100%）にするため、8 分の 1 単位で四捨五入する。
function __pie_icon() {
    local int_pct="${1}"
    local icons=(󰝦 󰪞 󰪟 󰪠 󰪡 󰪢 󰪣 󰪤 󰪥)
    local idx=$(((int_pct * 8 + 50) / 100))
    if [[ "${idx}" -gt 8 ]]; then idx=8; fi
    printf '%s' "${icons[${idx}]}"
}

# 割合に応じた文字色: 緑（50% 未満）、黄（50-79%）、赤（80% 以上）
function __pct_fg() {
    local int_pct="${1}"
    if [[ "${int_pct}" -ge 80 ]]; then
        printf '%s' "${FG_RED}"
    elif [[ "${int_pct}" -ge 50 ]]; then
        printf '%s' "${FG_YELLOW}"
    else
        printf '%s' "${FG_GREEN}"
    fi
}

function claude_statusline() {
    local input project_dir cwd model cost context five_hour seven_day
    input="$(cat)"
    project_dir="$(jq -r '.workspace.project_dir // .cwd // empty' <<< "${input}")"
    cwd="$(jq -r '.cwd // empty' <<< "${input}")"
    model="$(jq -r '.model.display_name // empty' <<< "${input}")"
    cost="$(jq -r '.cost.total_cost_usd // empty' <<< "${input}")"
    context="$(jq -r 'if .context_window.used_percentage then (.context_window.used_percentage | floor | tostring) else empty end' <<< "${input}")"
    five_hour="$(jq -r 'if .rate_limits.five_hour.used_percentage then (.rate_limits.five_hour.used_percentage | floor | tostring) else empty end' <<< "${input}")"
    seven_day="$(jq -r 'if .rate_limits.seven_day.used_percentage then (.rate_limits.seven_day.used_percentage | floor | tostring) else empty end' <<< "${input}")"

    local project_text project_name rel model_text cost_text
    local context_fg context_text five_fg five_text seven_fg seven_text
    # --- 各セグメントの文字列を組み立てる ---

    project_text=""
    if [[ -n "${project_dir}" ]]; then
        project_name="$(basename "${project_dir}")"
        if [[ -n "${cwd}" && "${cwd}" != "${project_dir}" ]]; then
            rel="$("${REALPATH_CMD}" -m -s --relative-to="${project_dir}" "${cwd}")"
            [[ "${rel}" == ..* ]] || rel="./${rel}"
            project_text=" [${project_name}](${rel}/) "
        else
            project_text=" [${project_name}] "
        fi
    fi

    model_text=" ${model} "

    cost_text=""
    if [[ -n "${cost}" ]]; then
        cost_text="$(printf ' $%.1f ' "${cost}")"
    fi

    context_fg="${FG_LIGHT}"
    context_text=""
    if [[ -n "${context}" ]]; then
        context_fg="$(__pct_fg "${context}")"
        context_text=" $(__pie_icon "${context}") ctx ${context}% "
    fi

    five_fg="${FG_LIGHT}"
    five_text=""
    if [[ -n "${five_hour}" ]]; then
        five_fg="$(__pct_fg "${five_hour}")"
        five_text=" $(__pie_icon "${five_hour}") 5h ${five_hour}% "
    fi

    seven_fg="${FG_LIGHT}"
    seven_text=""
    if [[ -n "${seven_day}" ]]; then
        seven_fg="$(__pct_fg "${seven_day}")"
        seven_text=" $(__pie_icon "${seven_day}") 7d ${seven_day}% "
    fi

    # --- 書式を付けて出力する（セグメントの順番はここで入れ替える） ---
    __format \
        "Background=${BG_ORANGE}" "Foreground=${FG_DARK}" "Text=${project_text}" ResetAttributes \
        "Background=${BG_GRAY1}" "Foreground=${FG_LIGHT}" "Text=${model_text}" ResetAttributes \
        "Background=${BG_GRAY2}" "Foreground=${FG_LIGHT}" "Text=${cost_text}" ResetAttributes \
        "Background=${BG_GRAY3}" "Foreground=${context_fg}" "Text=${context_text}" ResetAttributes \
        "Background=${BG_GRAY4}" "Foreground=${five_fg}" "Text=${five_text}" ResetAttributes \
        "Background=${BG_GRAY5}" "Foreground=${seven_fg}" "Text=${seven_text}" ResetAttributes
}

claude_statusline
