#! /usr/bin/env bash

set -e -u -o pipefail

# 自分が個人としてレビュアーに指定された、開いている PR の通知が来るまで待ち、
# 来たらその一覧を出して終わる。チーム経由の依頼は、--team で渡したチームあてのものだけ拾う。
# --repo で渡したリポジトリは、依頼が無くても、開かれたか draft から外れた PR を拾う。通知は既読にしない。
# --follow では終わらずに出し続ける。

INTERVAL=60
readonly INTERVAL
MAX_TRIES=720
readonly MAX_TRIES
# $me などは jq の変数で、シェルに展開させないためシングルクォートで囲む
# shellcheck disable=SC2016
FILTER='
  select(.state == "open")
  | .base.repo.full_name as $repo
  | ($repo | split("/")[0]) as $org
  | [.requested_teams[] | "\($org)/\(.slug)" | select(. as $t | $teams | index($t))] as $matched
  | (if ([.requested_reviewers[].login] | index($me)) then ""
     elif ($matched | length > 0) then " [team: \($matched | join(", "))]"
     else empty
     end) as $via
  | "\($repo)#\(.number) \(.user.login) | \(.title) \(.html_url)\($via)"'
readonly FILTER
# draft はレビューを頼む前の段階なので拾わない。
# draft から外れた時刻は REST の PR に無いため、作られた時刻ではなく、
# 見始めたときに無かった PR かどうかで新しいものを見分ける
# shellcheck disable=SC2016
OPENED_FILTER='
  .[]
  | select((.draft | not) and .user.login != $me and ($before == "" or .created_at < $before))
  | "\(.base.repo.full_name)#\(.number) \(.user.login) | \(.title) \(.html_url) [opened]"'
readonly OPENED_FILTER

function usage() {
    local COMMAND="gh-watch-review-requests"
    readonly COMMAND
    cat <<- HEREDOC
		Usage: ${COMMAND} [OPTIONS] [SINCE]

		Wait until a pull request requests your review as an individual,
		then print the requests and exit.
		Requests to a team you belong to are ignored unless the team is given with -t.
		In repositories given with -r, every pull request opened or marked ready for review is picked up.
		Notifications are not marked as read.

		Options:
		  -t, --team ORG/TEAM    Also pick up requests to this team (repeatable)
		  -r, --repo OWNER/REPO  Also pick up pull requests opened or marked ready for review
		                         in this repository, except your own (repeatable)
		  -f, --follow           Keep printing new requests instead of exiting
		  -s, --state FILE       Save the time looked up to and the pull requests printed
		                         to FILE, and resume from it
		  -h, --help             Show this help

		Arguments:
		  SINCE  ISO 8601 time to look from (default: the time in FILE, or now)
	HEREDOC
}

# 前回の応答から変わっていれば本文を出す。変わっていなければ何も出さずに失敗を返す。
# 304 の応答は API の利用回数に数えられないので、変化が無い回は回数を使わない
function __fetch_if_changed() {
    local etag_file="${1}"
    local url="${2}"
    local headers=()
    local response status
    if [[ -n "${etag_file}" && -s "${etag_file}" ]]; then
        headers=(-H "If-None-Match: $(< "${etag_file}")")
    fi
    # gh api は 304 も失敗の終了コードで返すので、終了コードではなく状態行で見分ける
    response="$(gh api -i "${headers[@]+"${headers[@]}"}" "${url}" 2> /dev/null)" || true
    status="$(head -n 1 <<< "${response}" | awk '{ print $2 }')"
    if [[ "${status}" != 200 ]]; then
        return 1
    fi
    if [[ -n "${etag_file}" ]]; then
        sed -n 's/^[Ee][Tt][Aa][Gg]: *//p' <<< "${response}" | tr -d '\r' > "${etag_file}"
    fi
    awk 'body { print; next } /^\r?$/ { body = 1 }' <<< "${response}"
}

function __requested_to_me() {
    local since="${1}"
    local me="${2}"
    local teams="${3}"
    local etag_file="${4}"
    local notifications url
    if ! notifications="$(__fetch_if_changed "${etag_file}" "notifications?all=true&since=${since}")"; then
        return 0
    fi
    while IFS= read -r -u 3 url; do
        gh api "${url}" 2> /dev/null \
            | jq -r --arg me "${me}" --argjson teams "${teams}" "${FILTER}" \
            || true
    done 3< <(jq -r '.[] | select(.reason == "review_requested" and .subject.type == "PullRequest") | .subject.url' <<< "${notifications}")
}

function __opened_in() {
    local before="${1}"
    local me="${2}"
    local etag_dir="${3}"
    shift 3
    local repo etag_file url pulls
    for repo in "${@}"; do
        etag_file=""
        if [[ -n "${etag_dir}" ]]; then
            etag_file="${etag_dir}/${repo//\//_}"
        fi
        url="repos/${repo}/pulls?state=open&per_page=100"
        # --paginate は条件付きで取れないので、1 ページ目で変化を見て、収まらないときだけ全ページを取り直す
        if ! pulls="$(__fetch_if_changed "${etag_file}" "${url}")"; then
            continue
        fi
        if [[ "$(jq length <<< "${pulls}")" -ge 100 ]]; then
            pulls="$(gh api --paginate "${url}" 2> /dev/null)" || continue
        fi
        jq -r --arg before "${before}" --arg me "${me}" "${OPENED_FILTER}" <<< "${pulls}" || true
    done
}

function gh_watch_review_requests() {
    local since=""
    local team_args=()
    local repos=()
    local follow=false
    local state=""

    while [[ ${#} -gt 0 ]]; do
        case "${1}" in
            -h | --help)
                usage
                exit 0
                ;;
            -t | --team)
                if [[ ${#} -lt 2 || ! "${2}" =~ ^[^/]+/[^/]+$ ]]; then
                    usage >&2
                    exit 1
                fi
                team_args+=("${2}")
                shift 2
                ;;
            -r | --repo)
                if [[ ${#} -lt 2 || ! "${2}" =~ ^[^/]+/[^/]+$ ]]; then
                    usage >&2
                    exit 1
                fi
                repos+=("${2}")
                shift 2
                ;;
            -f | --follow)
                follow=true
                shift
                ;;
            -s | --state)
                if [[ ${#} -lt 2 ]]; then
                    usage >&2
                    exit 1
                fi
                state="${2}"
                shift 2
                ;;
            -*)
                echo "Error: unknown option: ${1}" >&2
                exit 1
                ;;
            *)
                if [[ -n "${since}" ]]; then
                    echo "Error: unexpected argument: ${1}" >&2
                    exit 1
                fi
                since="${1}"
                shift
                ;;
        esac
    done

    # 状態ファイルは 1 行目が見た時刻、2 行目からが出し終えた PR（owner/repo#番号）
    local seen=""
    if [[ -n "${state}" && -s "${state}" ]]; then
        if [[ -z "${since}" ]]; then
            since="$(head -n 1 "${state}")"
        fi
        seen="$(tail -n +2 "${state}")"
    fi
    if [[ -z "${since}" ]]; then
        since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi

    local me teams etag_dir
    me="$(gh api user --jq .login)"
    teams="$(printf '%s\n' "${team_args[@]+"${team_args[@]}"}" | jq -R -s -c 'split("\n") | map(select(length > 0))')"
    etag_dir="$(mktemp -d)"
    # local の変数は関数を抜けると消えるので、trap を仕掛ける時点で展開しておく
    # shellcheck disable=SC2064
    trap "rm -rf '${etag_dir}'" EXIT
    # ここで ETag を控えると、見始めてから最初の回までに開かれた PR が 304 に隠れるので控えない
    if [[ (-z "${state}" || ! -s "${state}") && ${#repos[@]} -gt 0 ]]; then
        seen="$(__opened_in "${since}" "${me}" "" "${repos[@]}" | awk '{ print $1 }')"
    fi
    echo "since=${since}"

    local i found checked_at fresh
    for ((i = 1; i <= MAX_TRIES; i++)); do
        sleep "${INTERVAL}"
        # 1 回見るあいだに届いた通知を取りこぼさないよう、見る前の時刻から次を始める
        checked_at="$(date -u -v-1M +%Y-%m-%dT%H:%M:%SZ)"
        if ! found="$(
            __requested_to_me "${since}" "${me}" "${teams}" "${etag_dir}/notifications"
            __opened_in "" "${me}" "${etag_dir}" "${repos[@]+"${repos[@]}"}"
        )"; then
            continue
        fi
        # 次の回と見る時刻が重なるうえ、通知は PR に動きがあるたびに出直すので、出した PR は除く
        fresh="$(sort -u <<< "${found}" | SEEN="${seen}" awk 'BEGIN { n = split(ENVIRON["SEEN"], s, "\n"); for (i = 1; i <= n; i++) done[s[i]] } NF && !($1 in done)')"
        if [[ -n "${fresh}" ]]; then
            echo "$(date +%H:%M) review requested to me:"
            echo "${fresh}"
            seen="$(printf '%s\n%s' "${seen}" "$(awk '{ print $1 }' <<< "${fresh}")" | sed '/^$/d')"
        fi
        since="${checked_at}"
        if [[ -n "${state}" ]]; then
            printf '%s\n%s\n' "${since}" "${seen}" | sed '/^$/d' > "${state}"
        fi
        if [[ -n "${fresh}" && "${follow}" == false ]]; then
            echo "next_since=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            return
        fi
    done

    if [[ "${follow}" == true ]]; then
        return
    fi
    echo "Error: no review request within $((INTERVAL * MAX_TRIES / 3600))h" >&2
    exit 1
}

gh_watch_review_requests "${@}"
