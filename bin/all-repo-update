#! /usr/bin/env bash

set -e -u -o pipefail

# ghq で管理しているすべてのリポジトリを pull し、ブランチ・状態・stash を表示する。

function all_repo_update() {
    local repo_path short_path
    while IFS= read -r -u 3 repo_path; do
        short_path="$(echo "${repo_path}" | rev | cut -d '/' -f '1-3' | rev)"
        echo -e "\n==> Updating ${short_path}...\n"
        pushd "${repo_path}" &> /dev/null
        git pull --prune --recurse-submodules --jobs=10
        git branch
        git status --short --branch
        git stash list
        popd &> /dev/null
        echo -e "\n==> ${short_path} update completed.\n"
    done 3< <(ghq list --full-path)
}

all_repo_update
