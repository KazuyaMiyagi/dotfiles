#! /usr/bin/env bash

set -e -u -o pipefail

# 指定したコマンドがインストールされているかを調べる
function __is_installed() {
    type "${1}" &> /dev/null
}

function __homebrew_install() {
    if ! __is_installed brew; then
        echo "==> Installing Homebrew."
        /bin/bash -c "$(curl --fail --silent --show-error --location https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
    else
        echo "==> Homebrew was already installed."
    fi
}

function __homebrew_bundle_install() {
    brew bundle check &> /dev/null || {
        echo "==> Installing Homebrew dependencies…"
        brew bundle install
    }
}

function __homebrew_update() {
    echo "==> Updating Homebrew packages..."
    brew update
    brew upgrade --yes
    brew cleanup
    echo "==> Finished updating Homebrew packages."

    echo "==> Updating Homebrew cask packages..."
    brew upgrade --cask --greedy-latest --yes
    echo "==> Finished updating Homebrew cask packages."

    brew doctor || true
    brew bundle dump --no-describe --no-npm --file=- | sort --uniq > Brewfile
}

function __go_packages_update() {
    local package

    echo "==> Updating Go packages..."
    # brew bundle は足りない Go パッケージを入れるだけで、入っているものは新しくしないので、
    # Brewfile のすべてを最新のリリースで入れ直す。
    while read -r package; do
        go install "${package}@latest"
    done < <(sed -n -E 's/^go "([^"]+)".*/\1/p' Brewfile)
    echo "==> Finished updating Go packages."
}

function __github_web_flow_key_import() {
    # URL が返すものをそのまま信用せず固定しておくと、鍵が変わったときに気づけて
    # （新しい Web 上のコミットが "No public key" になる）、新しい指紋を手で確かめられる。
    local fingerprint="968479A1AFF927E37D1A566BB5690EEEBB952194"
    local key

    # 数年に一度しか変わらない鍵のために毎回取得すると、オフラインのときや GitHub の障害時に
    # set -e で bootstrap 全体が止まってしまう。
    if gpg --list-keys "${fingerprint}" &> /dev/null; then
        echo "==> GitHub web-flow GPG key was already imported."
        return
    fi

    echo "==> Importing GitHub web-flow GPG key..."
    if ! key="$(curl --fail --silent --show-error --location https://github.com/web-flow.gpg)"; then
        echo "==> Skipping GitHub web-flow GPG key: download failed."
        return
    fi
    if ! gpg --show-keys --with-colons <<< "${key}" 2> /dev/null \
        | awk -F: '$1 == "fpr" { print $10 }' | grep -qxF "${fingerprint}"; then
        echo "==> Skipping GitHub web-flow GPG key: ${fingerprint} is not in the downloaded keys."
        return
    fi
    # ownertrust は設定しない。ultimate にすると GitHub の鍵が署名した鍵まで有効になり、
    # lsign には SSH でコミットに署名する運用では作らない GPG の秘密鍵が要る。
    if ! gpg --import <<< "${key}"; then
        echo "==> Skipping GitHub web-flow GPG key: gpg --import failed."
        return
    fi
    echo "==> Finished importing GitHub web-flow GPG key."
}

function __gh_extensions_install() {
    local extensions=(
        github/gh-actions-lock
        github/gh-stack
    )
    local installed extension

    echo "==> Installing gh extensions..."
    # gh extension install はインストール済みの拡張では失敗するので、それは飛ばす。
    installed="$(gh extension list | cut -f2)"
    for extension in "${extensions[@]}"; do
        if grep -qxF "${extension}" <<< "${installed}"; then
            continue
        fi
        gh extension install "${extension}"
    done
    gh extension upgrade --all
    echo "==> Finished installing gh extensions."
}

function __vim_plug_install() {
    if [[ -f "${XDG_DATA_HOME}/vim/autoload/plug.vim" ]]; then
        echo "==> vim-plug was already installed."
    else
        echo "==> Installing vim-plug"
        curl --fail --silent --show-error --location --create-dirs --output "${XDG_DATA_HOME}/vim/autoload/plug.vim" \
            https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
    fi
}

function __vim_plug_package_install() {
    echo "==> Installing vim-plug packages."
    vim +PlugUpgrade +PlugUpdate +qa
}

function __asdf_plugins_install() {
    echo "==> Installing asdf plugins..."
    for plugin in $(cut -d ' ' -f1 ./asdf/tool-versions | tr '\n' ' '); do
        asdf plugin add "${plugin}"
    done
    echo "==> Finished installing asdf plugins."
}

function __asdf_plugins_update() {
    echo "==> Updating asdf plugins..."
    asdf plugin update --all
    echo "==> Finished updating asdf plugins."
}

function __asdf_plugins_python_apply_path() {
    echo "==> Applying asdf Python plugin patch..."
    pushd "${XDG_DATA_HOME}/asdf/plugins/python/" > /dev/null
    git reset --hard HEAD > /dev/null
    cat <<- 'HEREDOC' | git apply
	diff --git a/bin/list-all b/bin/list-all
	index c0ecb83..e934faa 100755
	--- a/bin/list-all
	+++ b/bin/list-all
	@@ -4,7 +4,7 @@ source "$(dirname "$0")/utils.sh"
	
	 list_all() {
	   install_or_update_python_build
	-  $(python_build_path) --definitions | tr '\n' ' '
	+  $(python_build_path) --definitions | grep -E -v -e '^.*t$' | tr '\n' ' '
	 }
	
	 list_all
	HEREDOC
    popd > /dev/null
    echo "==> Finished applying asdf Python plugin patch."
}

function __asdf_managed_tools_update() {
    echo "==> Updating asdf managed tools versions..."
    pushd asdf > /dev/null
    for plugin in $(cut -d ' ' -f1 ./tool-versions | tr '\n' ' '); do
        asdf install "${plugin}" latest
        asdf set "${plugin}" latest
    done
    popd > /dev/null
    echo "==> Finished updating asdf managed tools versions."
}

# npm で入れるサーバーが、入れ直したときと同じバージョンになっているかを調べる
function __npm_server_is_current() {
    local server_dir="${1}"
    local script="${2}"
    local report specs spec name version expected current

    # インストーラーは一部のパッケージをわざと固定している（typescript@6）ので、どれも最新のリリースと
    # 比べると、それらがずっと古いと判定される。代わりにインストーラー自身の指定を読み、
    # 入れ直したときに実際に取ってくるものと比べる。
    # ヘルパーを使わず npm を直接呼ぶインストーラーもあるので、両方の書き方を集める。
    specs="$(awk '/npm_install\.sh/ || /^[[:space:]]*npm install / { print $NF }' "${script}" | tr -d "\"'")"
    [[ -n "${specs}" ]] || return 1

    # npm outdated は更新があるときもレジストリにつながらないときも 0 以外で終わるので、
    # 終了コードからは何も分からない。代わりに結果を検証し、読めない結果は
    # 「何もしなくてよい」とは扱わずに入れ直しへ回す。
    report="$(cd "${server_dir}" && npm outdated --json 2> /dev/null)" || true
    jq -e . &> /dev/null <<< "${report}" || return 1

    for spec in ${specs}; do
        # 末尾の @version を除く。バージョンの無いスコープ付きの名前では空になる。
        name="${spec%@*}"
        [[ -n "${name}" ]] || name="${spec}"
        if [[ "${spec}" == "${name}" ]]; then
            version=""
        else
            version="${spec#"${name}@"}"
        fi

        current="$(jq -r --arg n "${name}" '.[$n].current // empty' <<< "${report}")"
        # npm outdated は最新のパッケージを出さない。
        [[ -n "${current}" ]] || continue

        if [[ -z "${version}" ]]; then
            expected="$(jq -r --arg n "${name}" '.[$n].latest // empty' <<< "${report}")"
        elif [[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            # 1 つのリリースに固定されているので、入れ直しても同じバージョンにしかならない。
            expected="${version}"
        else
            # 範囲で固定されているので、入れ直しても package.json に記録された範囲に収まる。
            expected="$(jq -r --arg n "${name}" '.[$n].wanted // empty' <<< "${report}")"
        fi
        [[ "${current}" == "${expected}" ]] || return 1
    done
}

# 指定したサーバーがインストールされていて、最新かを調べる
function __vim_lsp_server_is_current() {
    local server_dir="${1}"
    local server="${2}"
    local script="${3}"

    # インストールが途中で止まると、依存は残ってもエントリーポイントが無いので、
    # 後のバージョンの確認を信用せず、エントリーポイントが無ければ未インストールとして扱う。
    [[ -e "${server_dir}/${server}" ]] || return 1

    if [[ -f "${server_dir}/package.json" ]]; then
        __npm_server_is_current "${server_dir}" "${script}"
    elif [[ -x "${server_dir}/venv/bin/pip3" ]]; then
        local pip3="${server_dir}/venv/bin/pip3"
        local requested outdated
        # python-lsp-server[all] のような extras は依存を最新のリリースより下に抑えるので、
        # pip list --outdated はいつまでも空にならない。入れ直しで実際に新しくできるのは
        # 明示的に指定したパッケージだけなので、それに絞る。
        requested="$("${pip3}" inspect 2> /dev/null | jq -r '.installed[] | select(.requested) | .metadata.name' | sort)" || return 1
        outdated="$("${pip3}" list --outdated --format=json 2> /dev/null | jq -r '.[].name' | sort)" || return 1
        # 指定したパッケージが無いのは、インストーラーが求めたものを pip が報告できなかったということで、
        # 「何もしなくてよい」と読んではいけない。
        [[ -n "${requested}" ]] || return 1
        [[ -z "$(comm -12 <(echo "${requested}") <(echo "${outdated}"))" ]]
    else
        # バイナリを置くだけのサーバーは、インストーラーと一致するバージョンを示さず、
        # インストーラーのバージョンの調べ方をここで作り直すと上流と重複する。
        return 1
    fi
}

function __vim_lsp_settings_update() {
    local servers_root="${XDG_DATA_HOME}/vim-lsp-settings/servers"
    local installer_dir="${XDG_DATA_HOME}/vim/plugged/vim-lsp-settings/installer"
    local server_dir server script retries i

    echo "==> Updating vim-lsp-settings servers..."
    for server_dir in "${servers_root}"/*/; do
        server="$(basename "${server_dir}")"
        script="${installer_dir}/install-${server}.sh"
        if [[ ! -f "${script}" ]]; then
            echo "==> Skipping ${server}: installer not found."
            continue
        fi
        if __vim_lsp_server_is_current "${server_dir}" "${server}" "${script}"; then
            echo "==> Skipping ${server}: already up to date."
            continue
        fi

        echo "==> Updating ${server}..."
        # インストーラーは空のディレクトリを前提にしていて、ln -s に -f が無く、unzip は上書きの確認で止まる。
        # その場での更新はできないので、消してから入れ直す。
        rm -rf "${server_dir:?}"/*
        retries=3
        for i in $(seq 1 "${retries}"); do
            (cd "${server_dir}" && sh "${script}") && break
            if [[ "${i}" -ge "${retries}" ]]; then
                echo "==> Failed to update ${server} after ${retries} attempts."
                exit 1
            fi
            echo "==> Retrying ${server} (${i}/${retries})..."
            sleep $((i * 5))
        done
    done
    echo "==> Finished updating vim-lsp-settings servers."
}

function __tflint_init() {
    echo "==> Starting TFLint initialization..."
    tflint --init
    echo "==> TFLint initialization completed."
}

function __session_manager_plugin_install() {
    echo "==> Installing Session Manager Plugin..."

    local arch
    arch="$(uname -m)"
    local pkg_url
    if [[ "${arch}" == "arm64" ]]; then
        pkg_url="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac_arm64/session-manager-plugin.pkg"
    else
        pkg_url="https://s3.amazonaws.com/session-manager-downloads/plugin/latest/mac/session-manager-plugin.pkg"
    fi

    local tmp_dir tmp_pkg
    tmp_dir="$(mktemp -d /tmp/session-manager-plugin.XXXXXX)"
    tmp_pkg="${tmp_dir}/session-manager-plugin.pkg"
    curl --fail --silent --show-error --location --output "${tmp_pkg}" "${pkg_url}"
    sudo installer -pkg "${tmp_pkg}" -target /
    sudo ln -sf /usr/local/sessionmanagerplugin/bin/session-manager-plugin /usr/local/bin/session-manager-plugin
    rm -rf "${tmp_dir}"

    echo "==> Finished installing Session Manager Plugin."
}

function __gcloud_update() {
    echo "==> Updating gcloud components..."
    gcloud components update --quiet
    echo "==> Finished updating gcloud components."
}

function bootstrap() {
    cd "$(dirname "${0}")/.."

    echo "Starting bootstrap..."

    __homebrew_install
    __homebrew_update
    __homebrew_bundle_install
    __go_packages_update
    __github_web_flow_key_import
    __gh_extensions_install
    __vim_plug_install
    __vim_plug_package_install
    __asdf_plugins_install
    __asdf_plugins_update
    __asdf_plugins_python_apply_path
    __asdf_managed_tools_update
    __vim_lsp_settings_update
    __tflint_init
    __gcloud_update
    __session_manager_plugin_install

    echo "Bootstrap finished!"
}

bootstrap
